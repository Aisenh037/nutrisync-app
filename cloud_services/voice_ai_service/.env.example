# GCP Configuration
GCP_PROJECT_ID=nutrisync-gcp-dev
GCP_REGION=us-central1

# Service Account (JSON string or file path)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Speech-to-Text Configuration
STT_LANGUAGE_CODE=en-US
STT_MODEL=latest_long
STT_USE_ENHANCED=true

# Text-to-Speech Configuration
TTS_LANGUAGE_CODE=en-US
TTS_VOICE_NAME=en-US-Neural2-F
TTS_AUDIO_ENCODING=MP3
TTS_SPEAKING_RATE=1.0
TTS_PITCH=0.0
TTS_VOLUME_GAIN=0.0

# Translation Configuration
TRANSLATION_DEFAULT_TARGET=en
TRANSLATION_AUTO_DETECT=true

# Supported Languages (comma-separated)
SUPPORTED_LANGUAGES=en,hi,es,fr,de,it,pt,zh

# Server Configuration
PORT=8080
LOG_LEVEL=INFO