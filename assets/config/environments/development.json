{
  "firebase": {
    "projectId": "nutrisync-dev",
    "apiKey": "AIzaSyDemo-Development-Key",
    "authDomain": "nutrisync-dev.firebaseapp.com",
    "storageBucket": "nutrisync-dev.appspot.com",
    "messagingSenderId": "123456789",
    "appId": "1:123456789:web:development"
  },
  "features": {
    "enableAnalytics": false,
    "enableCrashlytics": false,
    "debugMode": true,
    "enableVoiceFeatures": true,
    "enablePremiumFeatures": true,
    "enableTestData": true,
    "enableMockServices": false
  },
  "api": {
    "baseUrl": "http://localhost:5001/nutrisync-dev/us-central1",
    "timeout": 30000,
    "retryAttempts": 3,
    "enableLogging": true
  },
  "app": {
    "name": "NutriSync Dev",
    "version": "1.0.0-dev",
    "buildNumber": "1",
    "environment": "development"
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-3.5-turbo",
    "maxTokens": 1000,
    "temperature": 0.7
  },
  "database": {
    "enableOfflineSupport": true,
    "cacheSizeBytes": 104857600,
    "enablePersistence": true
  },
  "gcp": {
    "projectId": "nutrisync-gcp-dev",
    "region": "us-central1",
    "apis": {
      "speechToText": {
        "enabled": true,
        "languageCode": "en-US",
        "model": "latest_long",
        "useEnhanced": true
      },
      "textToSpeech": {
        "enabled": true,
        "languageCode": "en-US",
        "voiceName": "en-US-Neural2-F",
        "audioEncoding": "MP3"
      },
      "vision": {
        "enabled": true,
        "features": ["OBJECT_LOCALIZATION", "TEXT_DETECTION", "LABEL_DETECTION"],
        "maxResults": 10
      },
      "translation": {
        "enabled": true,
        "defaultTargetLanguage": "en",
        "supportedLanguages": ["en", "es", "fr", "de", "it", "pt", "hi", "zh"]
      },
      "dialogflow": {
        "enabled": true,
        "agentId": "nutrisync-agent-dev",
        "sessionTimeout": 300
      },
      "maps": {
        "enabled": true,
        "defaultRadius": 5000,
        "maxResults": 20
      },
      "places": {
        "enabled": true,
        "types": ["grocery_or_supermarket", "health", "restaurant"],
        "maxResults": 20
      }
    },
    "services": {
      "cloudRun": {
        "region": "us-central1",
        "maxInstances": 5,
        "memory": "512Mi",
        "cpu": "1000m"
      },
      "cloudFunctions": {
        "region": "us-central1",
        "runtime": "nodejs18",
        "memory": "256MB",
        "timeout": "60s"
      }
    },
    "monitoring": {
      "enabled": true,
      "alerting": true,
      "costThreshold": 50.0
    }
  }
}