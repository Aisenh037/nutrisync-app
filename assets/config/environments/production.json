{
  "firebase": {
    "projectId": "nutrisyncapp-97089",
    "apiKey": "AIzaSyDemo-Production-Key",
    "authDomain": "nutrisyncapp-97089.firebaseapp.com",
    "storageBucket": "nutrisyncapp-97089.appspot.com",
    "messagingSenderId": "555666777",
    "appId": "1:555666777:web:production"
  },
  "features": {
    "enableAnalytics": true,
    "enableCrashlytics": true,
    "debugMode": false,
    "enableVoiceFeatures": true,
    "enablePremiumFeatures": true,
    "enableTestData": false,
    "enableMockServices": false
  },
  "api": {
    "baseUrl": "https://us-central1-nutrisyncapp-97089.cloudfunctions.net",
    "timeout": 30000,
    "retryAttempts": 5,
    "enableLogging": false
  },
  "app": {
    "name": "NutriSync",
    "version": "1.0.0",
    "buildNumber": "1",
    "environment": "production"
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-4",
    "maxTokens": 2000,
    "temperature": 0.7
  },
  "database": {
    "enableOfflineSupport": true,
    "cacheSizeBytes": 52428800,
    "enablePersistence": true
  },
  "gcp": {
    "projectId": "nutrisyncapp-97089",
    "region": "us-central1",
    "apis": {
      "speechToText": {
        "enabled": true,
        "languageCode": "en-US",
        "model": "latest_long",
        "useEnhanced": true
      },
      "textToSpeech": {
        "enabled": true,
        "languageCode": "en-US",
        "voiceName": "en-US-Neural2-F",
        "audioEncoding": "MP3"
      },
      "vision": {
        "enabled": true,
        "features": ["OBJECT_LOCALIZATION", "TEXT_DETECTION", "LABEL_DETECTION"],
        "maxResults": 10
      },
      "translation": {
        "enabled": true,
        "defaultTargetLanguage": "en",
        "supportedLanguages": ["en", "es", "fr", "de", "it", "pt", "hi", "zh"]
      },
      "dialogflow": {
        "enabled": true,
        "agentId": "nutrisync-agent-prod",
        "sessionTimeout": 300
      },
      "maps": {
        "enabled": true,
        "defaultRadius": 5000,
        "maxResults": 20
      },
      "places": {
        "enabled": true,
        "types": ["grocery_or_supermarket", "health", "restaurant"],
        "maxResults": 20
      }
    },
    "services": {
      "cloudRun": {
        "region": "us-central1",
        "maxInstances": 50,
        "memory": "2Gi",
        "cpu": "2000m"
      },
      "cloudFunctions": {
        "region": "us-central1",
        "runtime": "nodejs18",
        "memory": "1GB",
        "timeout": "60s"
      }
    },
    "monitoring": {
      "enabled": true,
      "alerting": true,
      "costThreshold": 1000.0
    }
  }
}