{
  "firebase": {
    "projectId": "nutrisync-staging",
    "apiKey": "AIzaSyDemo-Staging-Key",
    "authDomain": "nutrisync-staging.firebaseapp.com",
    "storageBucket": "nutrisync-staging.appspot.com",
    "messagingSenderId": "987654321",
    "appId": "1:987654321:web:staging"
  },
  "features": {
    "enableAnalytics": true,
    "enableCrashlytics": true,
    "debugMode": false,
    "enableVoiceFeatures": true,
    "enablePremiumFeatures": true,
    "enableTestData": false,
    "enableMockServices": false
  },
  "api": {
    "baseUrl": "https://us-central1-nutrisync-staging.cloudfunctions.net",
    "timeout": 30000,
    "retryAttempts": 3,
    "enableLogging": false
  },
  "app": {
    "name": "NutriSync Staging",
    "version": "1.0.0-staging",
    "buildNumber": "1",
    "environment": "staging"
  },
  "ai": {
    "provider": "openai",
    "model": "gpt-4",
    "maxTokens": 2000,
    "temperature": 0.7
  },
  "database": {
    "enableOfflineSupport": true,
    "cacheSizeBytes": 104857600,
    "enablePersistence": true
  },
  "gcp": {
    "projectId": "nutrisync-gcp-staging",
    "region": "us-central1",
    "apis": {
      "speechToText": {
        "enabled": true,
        "languageCode": "en-US",
        "model": "latest_long",
        "useEnhanced": true
      },
      "textToSpeech": {
        "enabled": true,
        "languageCode": "en-US",
        "voiceName": "en-US-Neural2-F",
        "audioEncoding": "MP3"
      },
      "vision": {
        "enabled": true,
        "features": ["OBJECT_LOCALIZATION", "TEXT_DETECTION", "LABEL_DETECTION"],
        "maxResults": 10
      },
      "translation": {
        "enabled": true,
        "defaultTargetLanguage": "en",
        "supportedLanguages": ["en", "es", "fr", "de", "it", "pt", "hi", "zh"]
      },
      "dialogflow": {
        "enabled": true,
        "agentId": "nutrisync-agent-staging",
        "sessionTimeout": 300
      },
      "maps": {
        "enabled": true,
        "defaultRadius": 5000,
        "maxResults": 20
      },
      "places": {
        "enabled": true,
        "types": ["grocery_or_supermarket", "health", "restaurant"],
        "maxResults": 20
      }
    },
    "services": {
      "cloudRun": {
        "region": "us-central1",
        "maxInstances": 10,
        "memory": "1Gi",
        "cpu": "1000m"
      },
      "cloudFunctions": {
        "region": "us-central1",
        "runtime": "nodejs18",
        "memory": "512MB",
        "timeout": "60s"
      }
    },
    "monitoring": {
      "enabled": true,
      "alerting": true,
      "costThreshold": 200.0
    }
  }
}